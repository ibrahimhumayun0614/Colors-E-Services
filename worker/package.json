{
  "name": "crm-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute crm-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute crm-db --remote --file=./schema.sql",
    "build:web": "npm run build --prefix ../web",
    "deploy:live": "npm run deploy && npm run build:web && npx wrangler pages deploy ../web/dist --project-name=crm-web --commit-dirty=true"
  },
  "dependencies": {
    "hono": "^4.7.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.8.2",
    "wrangler": "^4.0.0"
  }
}
